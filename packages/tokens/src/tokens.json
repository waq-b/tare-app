{
  "$description": "Tare design tokens. Single source of truth, taken from design/canvas/Tokens.dc.html and Charts.dc.html. Edit here, then run `npm run build -w @tare/tokens`.",
  "color": {
    "$description": "Themed colours. Both themes must have exactly the same keys (the build enforces this). Dark is the default theme.",
    "dark": {
      "bg": {
        "$value": "#0E0F14",
        "$description": "Ground"
      },
      "surface-1": {
        "$value": "#16171E",
        "$description": "Cards (elev.1)"
      },
      "surface-2": {
        "$value": "#1E2029"
      },
      "surface-3": {
        "$value": "#282B36"
      },
      "line": {
        "$value": "#2B2E3A",
        "$description": "Hairlines"
      },
      "line-strong": {
        "$value": "#3A3E4C"
      },
      "text": {
        "$value": "#ECEBE4"
      },
      "text-2": {
        "$value": "#A9AAB4"
      },
      "text-3": {
        "$value": "#8A8C99"
      },
      "accent": {
        "$value": "#CFE88E",
        "$description": "Lume: the one accent"
      },
      "on-accent": {
        "$value": "#12140C"
      },
      "progress": {
        "$value": "#7FD8A0",
        "$description": "Weight or reps go up"
      },
      "hold": {
        "$value": "#A9B6CB",
        "$description": "Keep as is, repeat"
      },
      "deload": {
        "$value": "#B9A7F2",
        "$description": "Planned lighter week"
      },
      "swap": {
        "$value": "#6FC8E0",
        "$description": "Exercise or volume change"
      },
      "warning": {
        "$value": "#F2B54A",
        "$description": "Needs attention, not urgent"
      },
      "safety-stop": {
        "$value": "#FF6259",
        "$description": "Stop. Only safety uses this"
      },
      "safety-stop-solid": {
        "$value": "#B3140C",
        "$description": "Full-bleed background of the call-999 screen (Safety-999)"
      },
      "on-safety-stop-solid": {
        "$value": "#FFFFFF"
      },
      "series-1": {
        "$value": "#3987E5",
        "$description": "Chart category colour. Never good/bad"
      },
      "series-2": {
        "$value": "#D95926"
      },
      "series-3": {
        "$value": "#199E70"
      },
      "muscle-idle": {
        "$value": "#2A2D39",
        "$description": "Muscle map: regions not worked (Icons, Exercise-Detail, Health-Flags)"
      },
      "scrim": {
        "$value": "rgba(4, 5, 8, 0.66)",
        "$description": "Behind sheets"
      },
      "shadow": {
        "$value": "rgba(0, 0, 0, 0.5)",
        "$description": "elev.2 shadow colour"
      }
    },
    "light": {
      "bg": {
        "$value": "#F3F2ED"
      },
      "surface-1": {
        "$value": "#FFFFFF"
      },
      "surface-2": {
        "$value": "#EAE9E3"
      },
      "surface-3": {
        "$value": "#DEDDD6"
      },
      "line": {
        "$value": "#D9D8D0"
      },
      "line-strong": {
        "$value": "#C4C3BA"
      },
      "text": {
        "$value": "#14151B"
      },
      "text-2": {
        "$value": "#4B4D57"
      },
      "text-3": {
        "$value": "#63656F"
      },
      "accent": {
        "$value": "#46650F"
      },
      "on-accent": {
        "$value": "#FFFFFF"
      },
      "progress": {
        "$value": "#1C7A47",
        "$description": "Darkened from the canvas's #1D7F4A (4.47:1 on bg) to pass 4.5:1. Decided 2026-09-22 (#18)"
      },
      "hold": {
        "$value": "#4E5F78"
      },
      "deload": {
        "$value": "#6247C2"
      },
      "swap": {
        "$value": "#0F6F8C"
      },
      "warning": {
        "$value": "#8F5A00"
      },
      "safety-stop": {
        "$value": "#C62A20"
      },
      "safety-stop-solid": {
        "$value": "#B3140C",
        "$description": "Not drawn in light on the canvas; same as dark so the 999 screen is identical in both themes"
      },
      "on-safety-stop-solid": {
        "$value": "#FFFFFF"
      },
      "series-1": {
        "$value": "#2A78D6"
      },
      "series-2": {
        "$value": "#EB6834"
      },
      "series-3": {
        "$value": "#1BAF7A"
      },
      "muscle-idle": {
        "$value": "#DEDDD6",
        "$description": "Not drawn in light on the canvas; uses surface-3"
      },
      "scrim": {
        "$value": "rgba(20, 21, 27, 0.45)",
        "$description": "Not on the Tokens board; taken from the light boards"
      },
      "shadow": {
        "$value": "rgba(20, 21, 27, 0.14)"
      }
    }
  },
  "tint": {
    "$description": "Normalises the canvas's ~40 alpha values into two steps. Emitted as color-mix() over the base colour, so a tint can never drift from it. `--<color>-tint` for fills, `--<color>-edge` for borders.",
    "steps": {
      "tint": {
        "$value": 12
      },
      "edge": {
        "$value": 40
      }
    },
    "colors": ["accent", "progress", "hold", "deload", "swap", "warning", "safety-stop"]
  },
  "muscle": {
    "$description": "Muscle map fills. Primary = accent, secondary = accent at 40%, matching fractional set counting (1 and 0.5).",
    "secondary-opacity": {
      "$value": 40
    }
  },
  "brand": {
    "$description": "miniquest family mark (pixel pip + 'a miniquest' in Silkscreen). Theme-independent. Only the family tag uses these.",
    "miniquest-pip": {
      "$value": "#D63A2F"
    },
    "miniquest-night": {
      "$value": "#15123A"
    },
    "miniquest-star": {
      "$value": "#EFE9FB"
    },
    "miniquest-mist": {
      "$value": "#C9C3E0"
    },
    "miniquest-dim": {
      "$value": "#8A7FB0"
    }
  },
  "safety": {
    "$description": "Visual level per safety_rules.json action. Colour + emphasis only: messages and actions always come from safety_rules.json. emphasis: solid = full-bleed; fill = tinted panel, coloured heading + icon; accent = neutral surface, coloured icon + edge only.",
    "stop_now_call_999": {
      "color": "safety-stop-solid",
      "emphasis": "solid"
    },
    "stop_and_contact_111": {
      "color": "warning",
      "emphasis": "fill"
    },
    "stop_and_see_gp": {
      "color": "warning",
      "emphasis": "fill"
    },
    "reduce_or_rest": {
      "color": "deload",
      "emphasis": "fill"
    },
    "modify_exercise": {
      "color": "swap",
      "emphasis": "fill"
    },
    "continue_with_caution": {
      "color": "warning",
      "emphasis": "accent",
      "$description": "Deliberate deviation: the canvas uses hold. Decided 2026-09-22"
    }
  },
  "font": {
    "sans": {
      "$value": ["Instrument Sans", "Helvetica Neue", "Helvetica", "sans-serif"],
      "$description": "Words"
    },
    "mono": {
      "$value": ["Azeret Mono", "ui-monospace", "SF Mono", "Menlo", "monospace"],
      "$description": "Every number (tabular)"
    },
    "pixel": {
      "$value": ["Silkscreen", "ui-monospace", "monospace"],
      "$description": "miniquest tag only"
    }
  },
  "type": {
    "$description": "Sizes and weights from the Tokens board. The board's specimen uses line-height 1.1 throughout, so line heights and tracking come from how the screens use each style. `caption` (13px, used ~500 times at 12–13px) and `button` (17/600) are not on the board; both are added and recorded in DESIGN.md.",
    "num-hero": {
      "family": "mono",
      "size": 72,
      "weight": 500,
      "line": 1.1,
      "tracking": "-0.03em",
      "numeric": true,
      "$description": "Dial / focus weight"
    },
    "num-xl": {
      "family": "mono",
      "size": 46,
      "weight": 600,
      "line": 1.1,
      "tracking": "-0.03em",
      "numeric": true,
      "$description": "Stepper value"
    },
    "num-l": {
      "family": "mono",
      "size": 26,
      "weight": 600,
      "line": 1,
      "tracking": "-0.02em",
      "numeric": true,
      "$description": "Set row"
    },
    "num-m": {
      "family": "mono",
      "size": 15,
      "weight": 500,
      "line": 1.2,
      "tracking": "0",
      "numeric": true,
      "$description": "Targets, diffs, history"
    },
    "display": {
      "family": "sans",
      "size": 30,
      "weight": 600,
      "line": 1.1,
      "tracking": "-0.02em",
      "$description": "Screen statements"
    },
    "title": {
      "family": "sans",
      "size": 22,
      "weight": 600,
      "line": 1.2,
      "tracking": "-0.01em",
      "$description": "Top bar"
    },
    "heading": {
      "family": "sans",
      "size": 18,
      "weight": 600,
      "line": 1.25,
      "tracking": "0",
      "$description": "Section heads"
    },
    "body": {
      "family": "sans",
      "size": 16,
      "weight": 400,
      "line": 1.5,
      "tracking": "0",
      "$description": "Default copy"
    },
    "button": {
      "family": "sans",
      "size": 17,
      "weight": 600,
      "line": 1.2,
      "tracking": "0",
      "$description": "Button labels and card titles (added in D0: every screen board uses 17/600, the Tokens board omits it)"
    },
    "body-s": {
      "family": "sans",
      "size": 14,
      "weight": 400,
      "line": 1.4,
      "tracking": "0",
      "$description": "Secondary copy"
    },
    "caption": {
      "family": "sans",
      "size": 13,
      "weight": 400,
      "line": 1.4,
      "tracking": "0",
      "$description": "Meta lines, chart axes (added in D0)"
    },
    "label": {
      "family": "sans",
      "size": 11,
      "weight": 600,
      "line": 1.2,
      "tracking": "0.1em",
      "uppercase": true,
      "$description": "Uppercase labels"
    }
  },
  "space": {
    "1": {
      "$value": 4
    },
    "2": {
      "$value": 8
    },
    "3": {
      "$value": 12
    },
    "4": {
      "$value": 16
    },
    "5": {
      "$value": 20
    },
    "6": {
      "$value": 24
    },
    "7": {
      "$value": 32
    },
    "8": {
      "$value": 48
    }
  },
  "radius": {
    "sm": {
      "$value": 8
    },
    "md": {
      "$value": 12
    },
    "lg": {
      "$value": 16
    },
    "xl": {
      "$value": 20
    },
    "sheet": {
      "$value": 28
    },
    "pill": {
      "$value": 999
    }
  },
  "touch": {
    "$description": "Primary actions live in the bottom 40% of the screen.",
    "min": {
      "$value": 48,
      "$description": "Minimum target"
    },
    "primary": {
      "$value": 56,
      "$description": "Primary inputs (56–64)"
    },
    "primary-lg": {
      "$value": 64
    },
    "focus": {
      "$value": 84,
      "$description": "Focus Done button"
    },
    "button": {
      "$value": 60,
      "$description": "Button height"
    },
    "button-compact": {
      "$value": 52
    }
  },
  "elevation": {
    "$description": "0: rows on ground. 1: cards, tone + hairline. 2: sheets and dialogs only.",
    "0": {
      "surface": "bg",
      "border": "line",
      "shadow": "none"
    },
    "1": {
      "surface": "surface-1",
      "border": "line",
      "shadow": "none"
    },
    "2": {
      "surface": "surface-1",
      "border": "line-strong",
      "shadow": "0 12px 32px"
    }
  },
  "motion": {
    "$description": "Haptics are the app's job, not tokens. Reduced motion swaps all movement for 120 ms fades; press-scale becomes 1.",
    "press": {
      "duration": 90,
      "easing": "ease-out",
      "$description": "Scale 0.97 on press. Every tappable"
    },
    "state": {
      "duration": 160,
      "easing": "ease-out",
      "$description": "Colour and fill changes"
    },
    "set-done": {
      "duration": 220,
      "easing": "cubic-bezier(0.2, 0.9, 0.3, 1.2)",
      "$description": "Check stamps in, row fill sweeps left to right"
    },
    "sheet": {
      "duration": 280,
      "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "$description": "Sheets rise"
    },
    "scrim": {
      "duration": 160,
      "easing": "ease-out",
      "$description": "Scrim fades"
    },
    "press-scale": {
      "$value": 0.97
    },
    "reduced": {
      "duration": 120,
      "easing": "linear"
    }
  }
}
