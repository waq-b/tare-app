{
  "name": "@tare/data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The only loader for vpt/ data: zod-validated, version-checked, typed accessors.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "imports": {
    "#vpt-source": {
      "tare-app": "./src/source-app.ts",
      "default": "./src/source-full.ts"
    }
  }
}
