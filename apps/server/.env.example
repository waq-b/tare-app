# Postgres (Supabase: the pooler connection string, transaction mode, port 6543).
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<ref>.supabase.co
# Browser origins allowed to call the API, comma-separated.
ALLOWED_ORIGINS=https://tare.example.com,http://localhost:5173
# Only for the allowlist CLI (creates Supabase accounts). Never set on the web service.
SUPABASE_SECRET_KEY=
