# Postgres connection string (Supabase: the pooler string, transaction mode, port 6543).
DATABASE_URL=
# Your Supabase project URL, used to verify sign-in tokens (JWKS).
SUPABASE_URL=
# Browser origins allowed to call the API, comma-separated (e.g. https://app.example.com,http://localhost:5173).
ALLOWED_ORIGINS=
# Port to listen on (defaults to 3000).
PORT=
# Only for the allowlist CLI (`npm run allow`), which creates Supabase accounts. Never set on the web service.
SUPABASE_SECRET_KEY=
# Postgres used by the server tests (throwaway databases are created in it). Defaults to postgres://localhost:5432/postgres.
TEST_DATABASE_URL=
